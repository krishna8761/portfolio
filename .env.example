# ── Booking confirmations (required in production) ──────────────────────────
# Gmail: Google Account → Security → 2-Step Verification → App passwords → create one.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=ks3920933@gmail.com
SMTP_PASS=your-16-character-app-password
MAIL_FROM="Monark Studio <ks3920933@gmail.com>"

# Optional: a fixed video-call room included in every invite (Google Meet / Zoom personal link).
# Without it, the invite says a link will follow by email.
MEETING_URL=

# ── Slot reservations (required in production) ─────────────────────────────
# Free Upstash Redis database: console.upstash.com → Create database → REST API tab.
# Stops two visitors booking the same time. Without it, bookings live in server memory (dev only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── SEO ─────────────────────────────────────────────────────────────────────
# The live domain, no trailing slash. Drives canonical tags, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://monarkstudio.in
# Google Search Console → Add property → URL prefix → "HTML tag" method:
# paste ONLY the value inside content="…" here, redeploy, then click Verify.
GOOGLE_SITE_VERIFICATION=
